{
	"name": "wiki0-web",
	"version": "0.0.0",
	"private": true,
	"description": "The wiki0.app landing page",
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "vp exec svelte-kit sync || echo ''",
		"lint": "vp -C ../.. lint apps/wiki0-web/src",
		"check": "vp exec svelte-kit sync && vp exec svelte-check --tsconfig ./tsconfig.json --tsgo-experimental-api",
		"check:watch": "vp exec svelte-kit sync && vp exec svelte-check --tsconfig ./tsconfig.json --watch --tsgo-experimental-api",
		"test": "pnpm run test:e2e",
		"test:e2e": "vp build && playwright test"
	},
	"devDependencies": {
		"@fontsource-variable/martian-mono": "catalog:",
		"@fontsource-variable/mona-sans": "catalog:",
		"@playwright/test": "catalog:",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@typescript/native": "catalog:",
		"playwright": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"tw-animate-css": "catalog:",
		"typescript": "catalog:typescript6",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	}
}
