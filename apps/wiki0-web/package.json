{
	"name": "wiki0-web",
	"version": "0.0.0",
	"private": true,
	"description": "The wiki0.app landing page",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "vp exec svelte-kit sync || echo ''",
		"lint": "vp -C ../.. lint apps/wiki0-web/src",
		"check": "vp exec svelte-kit sync && vp exec svelte-check --tsconfig ./tsconfig.json --tsgo-experimental-api",
		"check:watch": "vp exec svelte-kit sync && vp exec svelte-check --tsconfig ./tsconfig.json --watch --tsgo-experimental-api",
		"test": "pnpm run test:e2e",
		"test:e2e": "vp build && playwright test",
		"share-cards": "node scripts/generate-share-cards.ts"
	},
	"devDependencies": {
		"@fontsource-variable/martian-mono": "catalog:",
		"@fontsource-variable/mona-sans": "catalog:",
		"@fontsource/martian-mono": "catalog:",
		"@fontsource/mona-sans": "catalog:",
		"@lucide/svelte": "catalog:",
		"@playwright/test": "catalog:",
		"@resvg/resvg-js": "catalog:",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@twinkleplop/bash": "catalog:",
		"@twinkleplop/json": "catalog:",
		"@twinkleplop/markdown": "catalog:",
		"@twinkleplop/markdown-core": "catalog:",
		"@types/d3-force": "catalog:",
		"@types/d3-scale": "catalog:",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"bits-ui": "catalog:",
		"clsx": "catalog:",
		"d3-force": "catalog:",
		"d3-scale": "catalog:",
		"layerchart": "catalog:",
		"playwright": "catalog:",
		"svead": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwind-merge": "catalog:",
		"tailwind-variants": "catalog:",
		"tailwindcss": "catalog:",
		"tw-animate-css": "catalog:",
		"typescript": "catalog:typescript6",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	}
}
